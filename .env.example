# AI AURA — environment configuration
#
# PO_SSID: your Pocket Option Socket.IO auth string, captured from your own
# logged-in browser session. How to capture it:
#   1. Log in at pocketoption.com in your browser.
#   2. Open DevTools (F12) -> Network tab -> filter "WS" (WebSocket).
#   3. Reload the page, click the socket.io connection, open the "Messages" pane.
#   4. Find the outgoing frame that starts with:  42["auth",{"session":"...
#   5. Copy the ENTIRE frame (starting at 42) and paste it below between the
#      single quotes. Do not modify, truncate, or re-escape it.
#
# NEVER paste this value into chat, commit it, or share it. It is a live
# session credential for your account.
PO_SSID=''

# Set to 1 ONLY if TLS certificate verification fails in your environment.
# Leaving verification on protects the session credential in transit.
# PO_TLS_INSECURE=0

# ---- Deployment (cloud / anywhere-access) — optional ----
# Access token required by the API when set. MUST be set before exposing the
# app publicly (tunnel / cloud). The PWA asks for it once. Use a long random
# string. Never commit the real value.
# AIAURA_TOKEN=

# Postgres/Supabase connection string. When set, predictions are stored here
# instead of local SQLite (needed for cloud so data survives restarts).
# DATABASE_URL=postgresql://postgres:<PW>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# Comma-separated origins allowed to call the API from a browser (your Vercel
# URL). Default "*" is fine because auth is by bearer token, not cookies.
# ALLOWED_ORIGINS=https://your-app.vercel.app
